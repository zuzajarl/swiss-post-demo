# ─── ElevenLabs Agent ─────────────────────────────────────────────────────────
# Agent ID of the "Branch Closure Redirect & FAQ" agent built in the platform.
# If omitted, the web demo still renders but the Start Call button reports it.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Required only if the agent is set to "private" mode in the platform.
ELEVENLABS_API_KEY=

# ─── Python Backend ───────────────────────────────────────────────────────────
# URL of the FastAPI backend that serves the five agent tools.
# Local dev:  http://localhost:8000
# For the agent to reach it, expose it publicly:  ngrok http 8000
NEXT_PUBLIC_PYTHON_BACKEND_URL=http://localhost:8000

# ─── ElevenLabs Webhook Secret ────────────────────────────────────────────────
# From the ElevenLabs dashboard → Webhooks → Secret.
# The backend verifies HMAC-SHA256 signatures on every incoming tool call.
# Leave empty in local dev to skip verification.
ELEVENLABS_WEBHOOK_SECRET=

# ─── Swiss Post location data (live) ──────────────────────────────────────────
# Locations come from Swiss Post's own public location service — the one behind
# places.post.ch. No API key, no account. Override the base only to point at a
# different environment.
SWISSPOST_API_BASE=https://places.post.ch/StandortSuche/StaoCacheServiceV2/api/v1
SWISSPOST_API_TIMEOUT=8

# ─── Closure overlay ──────────────────────────────────────────────────────────
# The live location service has no closure field, so planned closures are joined
# on from data/closures.json by POI id.
#   on  (default) → demo closures are applied
#   off           → every location reports the status the live data supports
CLOSURE_OVERLAY=on
